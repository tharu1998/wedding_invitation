rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['YOUR_ADMIN_EMAIL@example.com'];
    }
    match /rsvps/{rsvpId} {
      // Guests can submit an RSVP but cannot read, change, or delete any response.
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'attendance', 'count', 'message', 'guestToken', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.attendance in ['yes', 'no']
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 6
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.guestToken is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
